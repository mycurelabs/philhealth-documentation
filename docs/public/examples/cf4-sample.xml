      pPassword=""
      pHciAccreNo="H12345678"
      pEnlistTotalCnt=""
      pProfileTotalCnt=""
      pSoapTotalCnt=""
      pEmrId=""
      pCertificationId="SAMPLE-CERT-ID"
      pHciTransmittalNumber="">

